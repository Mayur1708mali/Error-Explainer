# ─── Backend ─────────────────────────────────────────────────────────────────
# Port the API server listens on.
PORT=3001
# Bind address. Use 0.0.0.0 to allow external connections.
HOST=127.0.0.1

# Ollama API endpoint. Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Directory where the SQLite database, chunks.json, and scraped docs live.
# In production this should be an absolute path outside the source tree.
# Defaults to ./backend/data relative to the repo root.
DATA_DIR=./backend/data

# CORS origin for the frontend. In production (when Fastify serves the static
# bundle itself) this is not needed. Set it only for split deployments.
# CORS_ORIGIN=https://your-domain.com

# ─── Frontend (Vite build-time) ──────────────────────────────────────────────
# API base URL baked into the frontend bundle at build time.
# When Fastify serves both API and static files, set to empty string so the
# browser uses relative URLs (same origin).
VITE_API_BASE_URL=
